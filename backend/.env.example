DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_vendas
# Banco de testes — criado automaticamente pelo docker compose (scripts/init-test-db.sql)
TEST_DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_vendas_test
SQL_ECHO=false

# Obrigatório em produção: defina um valor forte e único (não use o default)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=8

ADMIN_EMAIL=admin@pyerp.local
ADMIN_USERNAME=admin
# Em produção: use senha forte; altere após o primeiro login em ambientes reais
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_CPF=00000000000
ADMIN_FULL_NAME=Administrador

# production: valida JWT_SECRET e ADMIN_PASSWORD fortes; desabilita /docs
ENV=development

# Frontend (Next.js). Lista separada por vírgula.
CORS_ORIGINS=http://localhost:3000

# Rate limit de POST /auth/login (janela deslizante)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Opcional: Redis compartilhado entre réplicas (senão usa memória do processo)
# REDIS_URL=redis://localhost:6379/0

# Atrás do Railway/proxy: liste hosts/IPs EXATOS do peer (match string, sem CIDR)
# Ex.: TRUSTED_PROXY_HOSTS=100.64.0.1,10.0.0.2
TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# Observabilidade
# Em produção: SENTRY_DSN é obrigatório (ou ALLOW_MISSING_SENTRY=1)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ALLOW_MISSING_SENTRY=1
# Com UVICORN_WORKERS>1 em produção: REDIS_URL obrigatório (ou ALLOW_MISSING_REDIS=1)
# ALLOW_MISSING_REDIS=1

# Ops / Appsmith — aprovação de cadastro de empresas
# PLATFORM_API_KEY=

# Container / runtime
# Local/compose: RUN_MIGRATIONS=1 (entrypoint). Railway: 0 + pre-deploy migrate.
# RUN_MIGRATIONS=1
# UVICORN_WORKERS=1
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
