DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_vendas
# Banco de testes — criado automaticamente pelo docker compose (scripts/init-test-db.sql)
TEST_DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_vendas_test
SQL_ECHO=false

# Obrigatório em produção: defina um valor forte e único (não use o default)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=8

ADMIN_EMAIL=admin@pyerp.local
ADMIN_USERNAME=admin
# Em produção: use senha forte; altere após o primeiro login em ambientes reais
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_CPF=00000000000
ADMIN_FULL_NAME=Administrador

# production: valida JWT_SECRET e ADMIN_PASSWORD fortes; desabilita /docs
ENV=development

# Frontend (Next.js). Lista separada por vírgula.
CORS_ORIGINS=http://localhost:3000

# Rate limit de POST /auth/login (janela deslizante)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Opcional: Redis compartilhado entre réplicas (senão usa memória do processo)
# REDIS_URL=redis://localhost:6379/0

# Atrás do Railway/proxy: IPs dos peers que podem enviar X-Forwarded-For
# TRUSTED_PROXY_HOSTS=10.0.0.0/8  (liste hosts exatos separados por vírgula)
TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# Observabilidade (opcional)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Container / runtime
# RUN_MIGRATIONS=1
# UVICORN_WORKERS=1
